generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Prisma seed
// Run with: npx prisma db seed


model accounts {
  id          String        @id @db.Char(36)
  business_id String        @db.Char(36)
  code        String?       @db.VarChar(20)
  name        String        @db.VarChar(255)
  type        accounts_type
  parent_id   String?       @db.Char(36)

  business    businesses    @relation(fields: [business_id], references: [id])
  parent      accounts?     @relation("accounts_parent", fields: [parent_id], references: [id])
  children    accounts[]    @relation("accounts_parent")
  journal_lines journal_lines[] @relation("journal_line_account")

  @@index([business_id], map: "idx_accounts_business_id")
}

model business_users {
  id          String              @id @db.Char(36)
  business_id String              @db.Char(36)
  user_id     String              @db.Char(36)
  role        business_users_role

  business    businesses          @relation(fields: [business_id], references: [id])
  user        users                @relation("user_business_memberships", fields: [user_id], references: [id])

  @@unique([business_id, user_id], map: "business_id_user_id_unique")
  @@index([user_id], map: "idx_business_users_user")
}

model businesses {
  id                 String   @id @db.Char(36)
  name               String   @db.VarChar(255)
  contact_email      String?  @db.VarChar(150)
  phone              String?  @db.VarChar(50)
  address            String?  @db.VarChar(500)
  fiscal_year_start  DateTime? @db.Date
  starting_money     Decimal? @db.Decimal(12, 2)
  loans              Json?
  loans_offered      Json?
  legal_name         String?  @db.VarChar(255)
  trade_name         String?  @db.VarChar(255)
  vat_number         String?  @db.VarChar(100)
  tax_id             String?  @db.VarChar(100)
  registration_no    String?  @db.VarChar(100)
  industry           String?  @db.VarChar(100)
  country            String?  @db.VarChar(100)
  city               String?  @db.VarChar(100)
  timezone           String?  @db.VarChar(100)
  subscription       String?  @db.VarChar(50)
  billing_cycle      String?  @db.VarChar(50)
  next_billing_date  DateTime? @db.Date
  status             String?  @db.VarChar(50)
  monthly_revenue    Decimal? @db.Decimal(12, 2)
  monthly_expenses   Decimal? @db.Decimal(12, 2)
  cash_balance       Decimal? @db.Decimal(12, 2)
  receivables_balance Decimal? @db.Decimal(12, 2)
  payables_balance    Decimal? @db.Decimal(12, 2)
  assets             Decimal? @db.Decimal(12, 2)
  liabilities        Decimal? @db.Decimal(12, 2)
  net_profit         Decimal? @db.Decimal(12, 2)
  equity             Decimal? @db.Decimal(12, 2)
  overdue_invoices   Int?
  revenue_trend      Json?
  expense_breakdown  Json?
  created_at         DateTime? @default(now()) @db.Timestamp(0)

  accounts          accounts[]
  business_users    business_users[]
  categories        categories[]
  contacts          contacts[]
  owner_applications owner_applications[]
  fiscal_years      fiscal_years[]
  journal_entries   journal_entries[]
  notifications     notifications[]
  payables          payables[]
  products          products[]
  purchases         purchases[]
  receivables       receivables[]
  reports           reports[]
  sales             sales[]
  stock_movements   stock_movements[]
  warehouses        warehouses[]
}

model categories {
  id          Int     @id @default(autoincrement())
  business_id String? @db.Char(36)
  name        String  @db.VarChar(100)

  business    businesses? @relation(fields: [business_id], references: [id])
  products    products[]

  @@index([business_id], map: "idx_categories_business_id")
}

model contacts {
  id          String        @id @db.Char(36)
  business_id String        @db.Char(36)
  name        String        @db.VarChar(255)
  type        contacts_type
  phone       String?       @db.VarChar(50)
  email       String?       @db.VarChar(150)

  business    businesses    @relation(fields: [business_id], references: [id])
  payables    payables[]    @relation("contact_payables")
  purchases   purchases[]   @relation("contact_purchases")
  receivables receivables[] @relation("contact_receivables")
  sales       sales[]       @relation("contact_sales")

  @@index([business_id], map: "idx_contacts_business_id")
}

model fiscal_years {
  id          String               @id @db.Char(36)
  business_id String               @db.Char(36)
  name        String?              @db.VarChar(50)
  start_date  DateTime?            @db.Date
  end_date    DateTime?            @db.Date
  status      fiscal_years_status? @default(OPEN)

  business    businesses          @relation(fields: [business_id], references: [id])

  @@index([business_id], map: "idx_fiscal_years_business_id")
}

model journal_entries {
  id             String                          @id @db.Char(36)
  business_id    String                          @db.Char(36)
  entry_date     DateTime?                       @db.Date
  reference      String?                         @db.VarChar(100)
  description    String?                         @db.Text
  created_by     String?                         @db.Char(36)
  created_at     DateTime?                       @default(now()) @db.Timestamp(0)
  reference_type journal_entries_reference_type?
  reference_id   String?                         @db.Char(36)
  fiscal_year_id String?                         @db.Char(36)

  business       businesses                     @relation(fields: [business_id], references: [id])
  creator        users?                         @relation("journal_entry_creator", fields: [created_by], references: [id])
  lines          journal_lines[]                @relation("journal_entry_lines")

  @@index([business_id], map: "idx_journal_business")
  @@index([entry_date], map: "idx_journal_date")
  @@index([reference_type, reference_id], map: "idx_journal_reference")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model journal_lines {
  id         String   @id @db.Char(36)
  journal_id String   @db.Char(36)
  account_id String?  @db.Char(36)
  debit      Decimal? @default(0.00) @db.Decimal(12, 2)
  credit     Decimal? @default(0.00) @db.Decimal(12, 2)

  journal    journal_entries @relation("journal_entry_lines", fields: [journal_id], references: [id], onDelete: Cascade)
  account    accounts?       @relation("journal_line_account", fields: [account_id], references: [id])

  @@index([account_id], map: "idx_journal_lines_account")
  @@index([journal_id], map: "idx_journal_lines_journal")
}

model loan_repayments {
  id           String    @id @db.Char(36)
  loan_id      String?   @db.Char(36)
  amount       Decimal?  @db.Decimal(12, 2)
  payment_date DateTime? @db.Date
}

model notifications {
  id          String              @id @db.Char(36)
  business_id String              @db.Char(36)
  user_id     String?             @db.Char(36)
  title       String?             @db.VarChar(255)
  message     String?             @db.Text
  type        notifications_type?
  created_at  DateTime?           @default(now()) @db.Timestamp(0)

  business    businesses          @relation(fields: [business_id], references: [id])
  user        users?              @relation("user_notifications", fields: [user_id], references: [id])

  @@index([business_id], map: "idx_notifications_business_id")
}

model payables {
  id           String           @id @db.Char(36)
  business_id  String?          @db.Char(36)
  supplier_id  String?          @db.Char(36)
  reference_id String?          @db.Char(36)
  amount       Decimal?         @db.Decimal(12, 2)
  due_date     DateTime?        @db.Date
  status       payables_status?

  business    businesses?     @relation(fields: [business_id], references: [id])
  supplier    contacts?        @relation("contact_payables", fields: [supplier_id], references: [id])

  @@index([business_id], map: "idx_payables_business")
}

model products {
  id            String    @id @db.Char(36)
  business_id   String    @db.Char(36)
  name          String    @db.VarChar(255)
  sku           String?   @db.VarChar(100)
  barcode       String?   @db.VarChar(100)
  unit_cost     Decimal?  @default(0.00) @db.Decimal(12, 2)
  unit_price    Decimal?  @default(0.00) @db.Decimal(12, 2)
  reorder_level Int?      @default(0)
  created_at    DateTime? @default(now()) @db.Timestamp(0)
  category_id   Int?

  business    businesses   @relation(fields: [business_id], references: [id])
  category    categories?  @relation(fields: [category_id], references: [id])
  purchase_items purchase_items[] @relation("product_purchase_items")
  sale_items     sale_items[]     @relation("product_sale_items")
  stock_movements stock_movements[] @relation("product_stock_movements")

  @@index([business_id], map: "idx_products_business")
  @@index([category_id], map: "idx_products_category")
}

model purchase_items {
  id          String @id @db.Char(36)
  purchase_id String @db.Char(36)
  product_id  String? @db.Char(36)
  qty         Int
  unit_cost   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  purchase purchases @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  product  products? @relation("product_purchase_items", fields: [product_id], references: [id])

  @@index([purchase_id], map: "idx_purchase_items_purchase")
}

model purchases {
  id            String            @id @db.Char(36)
  business_id   String            @db.Char(36)
  supplier_id   String?           @db.Char(36)
  purchase_date DateTime?         @db.Date
  total         Decimal?          @default(0.00) @db.Decimal(12, 2)
  paid          Decimal?          @default(0.00) @db.Decimal(12, 2)
  status        purchases_status? @default(PENDING)

  items purchase_items[]

  business    businesses?     @relation(fields: [business_id], references: [id])
  supplier    contacts?       @relation("contact_purchases", fields: [supplier_id], references: [id])

  @@index([business_id], map: "idx_purchases_business")
}

model receivables {
  id           String              @id @db.Char(36)
  business_id  String?             @db.Char(36)
  customer_id  String?             @db.Char(36)
  reference_id String?             @db.Char(36)
  amount       Decimal?            @db.Decimal(12, 2)
  due_date     DateTime?           @db.Date
  status       receivables_status?

  business    businesses?     @relation(fields: [business_id], references: [id])
  customer    contacts?       @relation("contact_receivables", fields: [customer_id], references: [id])

  @@index([business_id], map: "idx_receivables_business")
}

model reports {
  id           String        @id @db.Char(36)
  business_id  String        @db.Char(36)
  name         String?       @db.VarChar(100)
  type         reports_type?
  period_start DateTime?     @db.Date
  period_end   DateTime?     @db.Date
  data         String?       @db.Text
  file_url     String?       @db.VarChar(255)
  status       String?       @default("GENERATED") @db.VarChar(50)
  format       String?       @default("JSON") @db.VarChar(20)
  generated_at DateTime?     @default(now()) @db.Timestamp(0)

  business     businesses    @relation(fields: [business_id], references: [id])

  @@index([business_id], map: "idx_reports_business_id")
}

model sale_items {
  id         String @id @db.Char(36)
  sale_id    String @db.Char(36)
  product_id String? @db.Char(36)
  qty        Int
  unit_price Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)

  sale sales @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product products? @relation("product_sale_items", fields: [product_id], references: [id])

  @@index([sale_id], map: "idx_sale_items_sale")
}

model sales {
  id          String        @id @db.Char(36)
  business_id String        @db.Char(36)
  customer_id String?       @db.Char(36)
  sale_date   DateTime?     @db.Date
  total       Decimal?      @default(0.00) @db.Decimal(12, 2)
  paid        Decimal?      @default(0.00) @db.Decimal(12, 2)
  status      sales_status? @default(PENDING)

  items sale_items[]

  business    businesses?     @relation(fields: [business_id], references: [id])
  customer    contacts?       @relation("contact_sales", fields: [customer_id], references: [id])

  @@index([business_id], map: "idx_sales_business")
}

model stock_movements {
  id             String                          @id @db.Char(36)
  business_id    String                          @db.Char(36)
  product_id     String?                         @db.Char(36)
  warehouse_id   String?                         @db.Char(36)
  type           stock_movements_type
  reference_type stock_movements_reference_type?
  reference_id   String?                         @db.Char(36)
  quantity       Int
  unit_cost      Decimal?                        @db.Decimal(12, 2)
  movement_date  DateTime?                       @db.Date

  business      businesses                      @relation(fields: [business_id], references: [id])
  product       products?                       @relation("product_stock_movements", fields: [product_id], references: [id])
  warehouse     warehouses?                     @relation("warehouse_stock_movements", fields: [warehouse_id], references: [id])

  @@index([business_id], map: "idx_stock_business")
  @@index([product_id], map: "idx_stock_product")
}

model users {
  id         String    @id @db.Char(36)
  first_name String    @db.VarChar(100)
  last_name  String    @db.VarChar(100)
  email      String    @unique(map: "email") @db.VarChar(150)
  password   String    @db.VarChar(255)
  system_role user_system_role @default(NORMAL)
  created_at DateTime? @default(now()) @db.Timestamp(0)

  business_users  business_users[] @relation("user_business_memberships")
  notifications   notifications[] @relation("user_notifications")
  journal_entries journal_entries[] @relation("journal_entry_creator")
  owner_applications owner_applications[]
}

model owner_applications {
  id          String    @id @db.Char(36)
  business_id String    @db.Char(36)
  user_id     String    @db.Char(36)
  status      owner_application_status @default(PENDING)
  created_at  DateTime? @default(now()) @db.Timestamp(0)

  business    businesses @relation(fields: [business_id], references: [id])
  user        users      @relation(fields: [user_id], references: [id])

  @@index([business_id], map: "idx_owner_applications_business")
  @@index([user_id], map: "idx_owner_applications_user")
}

model warehouses {
  id          String  @id @db.Char(36)
  business_id String  @db.Char(36)
  name        String  @db.VarChar(100)
  location    String? @db.VarChar(255)

  business    businesses @relation(fields: [business_id], references: [id])
  stock_movements stock_movements[] @relation("warehouse_stock_movements")

  @@index([business_id], map: "business_id")
}

enum business_users_role {
  OWNER
  ADMIN
  MANAGER
}

enum contacts_type {
  CUSTOMER
  SUPPLIER
  LENDER
}

enum reports_type {
  BALANCE_SHEET
  INCOME_STATEMENT
  TRIAL_BALANCE
  LEDGER
  CASHBOOK
}

enum accounts_type {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum stock_movements_type {
  IN
  OUT
  ADJUSTMENT
}

enum fiscal_years_status {
  OPEN
  CLOSED
}

enum notifications_type {
  REPORT_READY
  SYSTEM_ALERT
  WARNING
  INFO
}

enum stock_movements_reference_type {
  SALE
  PURCHASE
  RETURN
  MANUAL
}

enum payables_status {
  OPEN
  PAID
  OVERDUE
}

enum purchases_status {
  PENDING
  PAID
  PARTIAL
}

enum receivables_status {
  OPEN
  PAID
  OVERDUE
}

enum sales_status {
  PENDING
  PAID
  PARTIAL
}

enum journal_entries_reference_type {
  SALE
  PURCHASE
  EXPENSE
  INCOME
  LOAN
  STOCK
  ADJUSTMENT
}

enum user_system_role {
  NORMAL
  ADMIN
  OWNER
  MANAGER
}

enum owner_application_status {
  PENDING
  APPROVED
  REJECTED
}
